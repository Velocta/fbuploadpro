{
  "$comment": "Configure lifecycle hooks (e.g. PreToolUse, PostToolUse, PreInvocation, PostInvocation, Stop).",
  "example-post-tool-hook": {
    "enabled": false,
    "PostToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/lint.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
