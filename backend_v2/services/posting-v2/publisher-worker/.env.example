SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
INTERNAL_JOB_DISPATCH_TOKEN=
INTEGRITY_PAUSE_THRESHOLD=3
INTEGRITY_WINDOW_SECONDS=300
# How the publisher sends bytes to Meta rupload after Graph "start":
# - stream (default): Worker reads R2 with bucket.get() and pipes the object body to rupload as application/octet-stream (Meta does not fetch your origin; avoids robots/WAF on public URLs; no full-file arrayBuffer in Worker).
# - hosted: Meta fetches file_url from POSTING_MEDIA_PUBLIC_BASE_URL/<media_object_key> (requires crawler-friendly robots and no edge blocks for Meta IPs).
POSTING_MEDIA_UPLOAD_MODE=stream
# Optional. HTTPS origin for hosted mode only. If unset, defaults to https://vinsmokemedia.online (apex R2 custom domain, not a subdomain). Meta uses facebookexternalhit/1.1; robots.txt must allow that fetch. Do not use fbcdn URLs.
POSTING_MEDIA_PUBLIC_BASE_URL=
