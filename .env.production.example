# ==============================================================================
# FBUploadPro: Production Environment Configuration Blueprint (.env.production)
# ==============================================================================
# IMPORTANT: Never commit actual production secrets to version control.
# Copy this file to .env.production or populate these variables in your deployment
# platforms (Vercel, Cloudflare Dashboard, and GitHub Actions Repository Secrets).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE & POSTGRESQL SUBSTRATE
# ------------------------------------------------------------------------------
# Production PostgreSQL connection string (Supabase pooled connection string via PgBouncer, port 6543).
# Must support SSL (sslmode=require).
# Format: postgresql://postgres.[project-ref]:[password]@[host]:6543/postgres?sslmode=require
DATABASE_URL="postgresql://postgres.REPLACE_PROJECT_REF:REPLACE_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require"

# Direct / unpooled connection string (Supabase port 5432 direct for executing schema DDL migrations)
# Format: postgresql://postgres.[project-ref]:[password]@[host]:5432/postgres?sslmode=require
DATABASE_DIRECT_URL="postgresql://postgres.REPLACE_PROJECT_REF:REPLACE_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require"

# ------------------------------------------------------------------------------
# 2. SUPABASE IDENTITY & AUTHENTICATION
# ------------------------------------------------------------------------------
# Supabase project URL and public anon key (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL="https://REPLACE_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.REPLACE_WITH_SUPABASE_ANON_KEY"

# Service Role Key for backend administration and webhooks (NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.REPLACE_WITH_SUPABASE_SERVICE_ROLE_KEY"

# ------------------------------------------------------------------------------
# 3. DOMAINS & TENANT MULTI-TENANCY ROUTING
# ------------------------------------------------------------------------------
# Canonical apex/root domain used for tenant subdomain extraction in Next.js middleware.
# Users access workspaces via https://[username].[NEXT_PUBLIC_ROOT_DOMAIN]
NEXT_PUBLIC_ROOT_DOMAIN="fbuploadpro.com"

# Fully qualified public application URL for the SaaS application portal (login & signup)
NEXT_PUBLIC_APP_URL="https://app.fbuploadpro.com"

# Fully qualified public URL for the independently hosted marketing site
NEXT_PUBLIC_MARKETING_URL="https://fbuploadpro.com"

# ------------------------------------------------------------------------------
# 4. AUTHENTICATION & CRYPTOGRAPHY
# ------------------------------------------------------------------------------
# HMAC-SHA256 session token signing secret.
# Format: Cryptographically secure random string, MINIMUM 32 characters.
# Generate via: openssl rand -base64 32
SESSION_SECRET="REPLACE_WITH_GENERATED_SESSION_SECRET_MIN_32_CHARS"

# AES-256-GCM symmetric key used to encrypt Facebook Page & User OAuth access tokens.
# Format: EXACTLY 64 hexadecimal characters (32 bytes / 256 bits).
# Generate via: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# ------------------------------------------------------------------------------
# 4. FACEBOOK GRAPH API v26.0 OAUTH & PUBLISHING
# ------------------------------------------------------------------------------
# Facebook App ID & App Secret created in Meta Developers Portal (https://developers.facebook.com).
# Ensure App is in 'Live' mode with approved pages_manage_posts and pages_read_engagement permissions.
FACEBOOK_APP_ID="123456789012345"
FACEBOOK_APP_SECRET="0123456789abcdef0123456789abcdef"

# Optional override for Facebook Graph API base URL (defaults to https://graph.facebook.com/v26.0)
# FB_GRAPH_API_URL="https://graph.facebook.com/v26.0"

# ------------------------------------------------------------------------------
# 5. CLOUDFLARE R2 OBJECT STORAGE (Dedicated Media Library)
# ------------------------------------------------------------------------------
# S3-compatible object storage for high-volume video/image uploads via presigned URLs.
# Found in Cloudflare Dashboard -> R2 Object Storage -> Manage R2 API Tokens.
R2_ACCOUNT_ID="REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID"
R2_ACCESS_KEY_ID="REPLACE_WITH_R2_ACCESS_KEY_ID"
R2_SECRET_ACCESS_KEY="REPLACE_WITH_R2_SECRET_ACCESS_KEY"
R2_BUCKET_NAME="fbuploadpro-media-prod"

# Public CDN domain pointing to the R2 bucket (Custom Domain configured on the bucket)
# Format: Must be a fully-qualified https:// URL without trailing slash
R2_PUBLIC_URL="https://media.fbuploadpro.com"

# Default tenant storage quota in bytes (Defaults to 5 GB: 5368709120 bytes)
DEFAULT_STORAGE_QUOTA_BYTES="5368709120"

# ------------------------------------------------------------------------------
# 6. CLOUDFLARE WORKER (Edge Publishing Dispatcher & Scheduler)
# ------------------------------------------------------------------------------
# The Cloudflare Worker (apps/worker) runs cron jobs every minute to claim due posts.
# Note: For apps/worker, set these as Cloudflare Worker Secrets (wrangler secret put).
ENVIRONMENT="production"

# Must match TOKEN_ENCRYPTION_KEY exactly so worker can decrypt tokens claimed from DB:
FB_ENCRYPTION_MASTER_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# ------------------------------------------------------------------------------
# 7. FINANCIAL & STRIPE TOKEN ECONOMY (Roadmap Milestone 7)
# ------------------------------------------------------------------------------
# Stripe API Keys from Stripe Dashboard -> Developers -> API Keys.
# Public key for Next.js frontend checkout elements
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_REPLACE_WITH_STRIPE_PUBLISHABLE_KEY"

# Restricted/Secret Key for server-side checkout session creation
STRIPE_SECRET_KEY="sk_live_REPLACE_WITH_STRIPE_SECRET_KEY"

# Stripe Webhook Signing Secret (from Webhook endpoint configured for checkout.session.completed)
# Format: whsec_...
STRIPE_WEBHOOK_SECRET="whsec_REPLACE_WITH_STRIPE_WEBHOOK_SECRET"
