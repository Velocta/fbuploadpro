SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
BROWSER_USER_DATA_DIR=.browser-profile
BROWSER_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/147.0.0.0 Safari/537.36
SKIP_STARTUP_LOGINS=false
MAX_REELS_PER_PLATFORM=1000

# yt-dlp discovery (TikTok/YouTube pending jobs)
# Cookies + User-Agent are always taken from the Puppeteer profile above.
YTDLP_BIN=yt-dlp
YTDLP_TIMEOUT_MS=120000
YTDLP_RETRIES=2
YTDLP_EXTRACTOR_RETRIES=3
YTDLP_SOCKET_TIMEOUT=30
YTDLP_SLEEP_REQUESTS=5
# Per-page incremental discovery archives (youtube-{pageId}.txt, tiktok-{pageId}.txt)
YTDLP_DOWNLOAD_ARCHIVE_DIR=
YTDLP_YOUTUBE_PLAYER_CLIENT=mweb
YTDLP_YOUTUBE_PO_TOKEN=
