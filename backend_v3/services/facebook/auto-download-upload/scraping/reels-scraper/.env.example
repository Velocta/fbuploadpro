SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
BROWSER_USER_DATA_DIR=.browser-profile
BROWSER_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/147.0.0.0 Safari/537.36
SKIP_STARTUP_LOGINS=false
MAX_REELS_PER_PLATFORM=1000
YTDLP_BIN=yt-dlp
YTDLP_TIMEOUT_MS=120000
# Facebook login is manual at startup; no FB credential env vars required.
# TikTok/YouTube: yt-dlp flat-playlist discovery first; failures queue browser_pending.
