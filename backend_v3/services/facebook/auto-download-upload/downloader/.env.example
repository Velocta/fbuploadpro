SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ADU_BUFFER_BUCKET=fbuploadpro-adu-buffer
ADU_DOWNLOADER_IDLE_WAIT_SECONDS=60
ADU_DOWNLOADER_CONCURRENCY=30
ADU_DOWNLOADER_ATTEMPT_RETRIES=4
ADU_DOWNLOADER_STALE_MINUTES=40
# Per-file aria2 connections (default 4). Lower = fewer sockets at high concurrency.
ADU_ARIA2_MAX_CONNECTION=4
ADU_ARIA2_SPLIT=4
# R2 upload read chunk size in bytes (default 8MB). Bounds RAM per active upload.
ADU_R2_UPLOAD_CHUNK_BYTES=8388608
# Optional proxies (omit to download without proxies)
# RESIDENTIAL_PROXY — YouTube full yt-dlp
# DATACENTER_PROXY — Instagram metadata only; TikTok/Facebook full yt-dlp
RESIDENTIAL_PROXY=
DATACENTER_PROXY=
