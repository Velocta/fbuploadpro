  "font": {
    "family": {
      "mono": {
        "$type": "fontFamily",
        "$value": "ui-monospace, SFMono-Regular, Menlo, Consolas, \"Liberation Mono\", monospace"
      },
      "sans": {
        "$type": "fontFamily",
        "$value": "system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif"
      }
    },
    "featureSettings": {
      "$type": "string",
      "$value": "'cv02', 'cv03', 'cv04', 'cv11'"
    },
    "lineHeight": {
      "body": {
        "$type": "number",
        "$value": 1.5
      },
      "heading": {
        "$description": "Standard headings",
        "$type": "number",
        "$value": 1.2
