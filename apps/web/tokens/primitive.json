  "motion": {
    "$description": "Motion — exit faster than enter (exit uses the next-shorter duration step). Reduced-motion handling lives in the base CSS layer (PR-F2).",
    "duration": {
      "base": {
        "$description": "Default transitions",
        "$type": "duration",
        "$value": {
          "unit": "ms",
          "value": 150
        }
      },
      "fast": {
        "$description": "Micro feedback, exits",
        "$type": "duration",
        "$value": {
          "unit": "ms",
          "value": 100
        }
      },
      "slow": {
        "$description": "Panels, drawers",
        "$type": "duration",
        "$value": {
          "unit": "ms",
          "value": 200
        }
      },
      "slower": {
        "$description": "Large surface entrances",
        "$type": "duration",
        "$value": {
          "unit": "ms",
          "value": 300
        }
      }
    },
    "easing": {
      "enter": {
        "$description": "Decelerate — entrances",
        "$type": "cubicBezier",
        "$value": [
          0,
          0,
          0.2,
          1
        ]
      },
      "exit": {
        "$description": "Accelerate — exits",
        "$type": "cubicBezier",
        "$value": [
          0.4,
          0,
          1,
          1
        ]
      },
      "linear": {
        "$type": "cubicBezier",
        "$value": [
          0,
          0,
          1,
          1
        ]
      },
      "standard": {
        "$type": "cubicBezier",
        "$value": [
          0.4,
          0,
          0.2,
          1
        ]
      }
    }
  },
