{
  "$description": "Primitive design tokens — the raw Binance identity values, captured from the shipped globals.css / theme.ts (spec 129, PR-F1). Hand-edit ONLY files in apps/web/tokens/; everything else is generated. Never reference primitives directly from component code — consume semantic tokens.",
  "breakpoint": {
    "$description": "One breakpoint set, replacing the ad-hoc 440/639/767/768/1023 scatter. Boundaries align to the shipped media queries (max-width 639/767, min-width 768, max-width 1023).",
    "lg": {
      "$type": "dimension",
      "$value": "1024px"
    },
    "md": {
      "$type": "dimension",
      "$value": "768px"
    },
    "sm": {
      "$type": "dimension",
      "$value": "640px"
    },
    "xl": {
      "$type": "dimension",
      "$value": "1280px"
    }
  },
  "container": {
    "$description": "Container scale for max-w-* (Tailwind v4 defaults). Named separately from the spacing ladder: in Tailwind v4, max-w-<key> also resolves through the --spacing-* namespace, so the spacing tokens' xs/sm/md/lg/xl names silently captured max-w-md (=12px) etc. until this scale was defined (found by spec 142's mobile e2e on PR-136A: the login card collapsed to a 12px max-width).",
    "xs": {
      "$type": "dimension",
      "$value": "20rem"
    },
    "sm": {
      "$type": "dimension",
      "$value": "24rem"
    },
    "md": {
      "$type": "dimension",
      "$value": "28rem"
    },
    "lg": {
      "$type": "dimension",
      "$value": "32rem"
    },
    "xl": {
      "$type": "dimension",
      "$value": "36rem"
    },
    "2xl": {
      "$type": "dimension",
      "$value": "42rem"
    },
    "3xl": {
      "$type": "dimension",
      "$value": "48rem"
    },
    "4xl": {
      "$type": "dimension",
      "$value": "56rem"
    },
    "5xl": {
      "$type": "dimension",
      "$value": "64rem"
    },
    "6xl": {
      "$type": "dimension",
      "$value": "72rem"
    },
    "7xl": {
      "$type": "dimension",
      "$value": "80rem"
    }
  },
