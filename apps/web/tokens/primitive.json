        "$description": "Display headings (heading range 1.0–1.3)",
        "$type": "number",
        "$value": 1.0
      }
    },
    "size": {
      "$description": "Type scale — 1.25 modular ratio on a 14px product body (UI research §5). The 13px step is the named metadata step (the de-facto 0.8125rem used across dense surfaces), not an accident.",
      "body": {
        "$description": "Product body size (1rem = 16px; body renders at 0.875rem)",
        "$type": "dimension",
        "$value": "14px"
      },
      "lg": {
        "$description": "14 * 1.25 — lead text, h4",
        "$type": "dimension",
        "$value": "17.5px"
      },
      "metadata": {
        "$description": "Named metadata step — dense tables, captions, secondary labels",
        "$type": "dimension",
        "$value": "13px"
      },
      "xl": {
        "$description": "14 * 1.25^2 — h3",
        "$type": "dimension",
        "$value": "21.88px"
      },
      "xs": {
        "$description": "14 / 1.25^2 — fine print",
        "$type": "dimension",
        "$value": "11.2px"
      },
      "xxl": {
        "$description": "14 * 1.25^3 — h2",
        "$type": "dimension",
        "$value": "27.34px"
      },
      "xxxl": {
        "$description": "14 * 1.25^4 — h1 / display",
        "$type": "dimension",
        "$value": "34.18px"
      }
    },
    "tabularNums": {
