# Database Connection (PostgreSQL)
DATABASE_URL="postgres://postgres:postgres@localhost:5432/fbuploadpro"

# Root Domain & Tenant Configuration
NEXT_PUBLIC_ROOT_DOMAIN="localhost:3000"

# Session Authentication Secret (HMAC-SHA256, minimum 32 chars)
SESSION_SECRET="super-secret-session-signing-key-minimum-32-chars-long"

# Facebook Graph API v26.0 App Credentials
FACEBOOK_APP_ID="your_facebook_app_id"
FACEBOOK_APP_SECRET="your_facebook_app_secret"

# Token Encryption Secret Key (256-bit / 32 bytes hex-encoded, exactly 64 characters)
TOKEN_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

