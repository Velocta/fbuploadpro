# Root Domain & Tenant Configuration
NEXT_PUBLIC_ROOT_DOMAIN="localhost:3000"

# Session Authentication Secret (HMAC-SHA256, minimum 32 chars)
SESSION_SECRET="REPLACE_ME__generate_with_openssl_rand_base64_48"

# Facebook App Credentials: None in process.env (strictly per-workspace BYOC in database)

# Token Encryption Secret Key (256-bit / 32 bytes hex-encoded, exactly 64 characters)
TOKEN_ENCRYPTION_KEY="REPLACE_ME__generate_with_openssl_rand_hex_32"

# Cloudflare R2 Storage (Media Library)
# Note: In development/test, if omitted, MockStorageProvider is used automatically.
# R2_ACCOUNT_ID="your_cloudflare_account_id"
# R2_ACCESS_KEY_ID="your_r2_access_key_id"
# R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
# R2_BUCKET_NAME="fbuploadpro-media-dev"
# R2_PUBLIC_URL="https://media.dev.fbuploadpro.com"

# WhatsApp Customer Support (Floating support button across all pages)
NEXT_PUBLIC_WHATSAPP_SUPPORT_NUMBER="+15551234567"
NEXT_PUBLIC_WHATSAPP_DEFAULT_MESSAGE="Hi! I need assistance with my FBUploadPro account."

# Registration Availability Guard ("true" to enable, "false" to temporarily pause new signups)
NEXT_PUBLIC_SIGNUPS_ENABLED="true"

