{
  // Type-aware linting project for contracts tests (Spec 098).
  // The main tsconfig.json can't include tests (rootDir: src would break
  // the build with TS6059), so tests get their own lint-only project.
  // The build (tsc in packages/contracts/) only reads ../tsconfig.json
  // and is unaffected by this file.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": ["./**/*", "../src/**/*"]
}
